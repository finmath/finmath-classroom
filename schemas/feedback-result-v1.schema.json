{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "finmath-classroom feedback result v1",
  "description": "Student feedback with claimed GitHub run context. This is not a trusted final grade.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "authoritative", "generated_at", "context", "rubric_sha256", "execution", "status", "score", "max_score", "feedback"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "finmath-classroom-feedback"},
    "authoritative": {"const": false},
    "generated_at": {"type": "string", "format": "date-time"},
    "context": {"$ref": "#/$defs/context"},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "status"],
      "properties": {
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "status": {"enum": ["completed", "timed_out", "error"]}
      }
    },
    "status": {"enum": ["passed", "failed", "incomplete", "error", "timed_out"]},
    "score": {"type": ["number", "null"], "minimum": 0},
    "max_score": {"type": "number", "exclusiveMinimum": 0},
    "feedback": {"$ref": "#/$defs/feedback"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"enum": ["passed", "failed"]}}},
    "then": {"properties": {"score": {"type": "number"}}},
    "else": {"properties": {"score": {"type": "null"}}}
  }],
  "$defs": {
    "positiveId": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repository", "commit", "ref", "run_id", "run_attempt", "event", "workflow_ref", "workflow_sha"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/positiveId"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
        "commit": {"$ref": "#/$defs/sha"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "run_id": {"$ref": "#/$defs/positiveId"},
        "run_attempt": {"$ref": "#/$defs/positiveId"},
        "event": {"type": "string", "minLength": 1, "maxLength": 2048},
        "workflow_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "workflow_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authoritative", "purpose", "cases", "status", "score", "max_score", "errors"],
      "properties": {
        "schema_version": {"const": 1},
        "authoritative": {"const": false},
        "purpose": {"const": "student feedback"},
        "status": {"enum": ["passed", "failed", "incomplete", "error"]},
        "score": {"type": "number", "minimum": 0},
        "max_score": {"type": "number", "exclusiveMinimum": 0},
        "errors": {"type": "array", "items": {"type": "string"}},
        "cases": {
          "type": "array", "minItems": 1, "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "occurrences", "points", "max_points"],
            "oneOf": [
              {"required": ["class_name", "method"], "not": {"required": ["suite"]}},
              {"required": ["suite"], "not": {"anyOf": [{"required": ["class_name"]}, {"required": ["method"]}]}}
            ],
            "properties": {
              "suite": {"const": "Maven test suite"},
              "class_name": {"type": "string", "minLength": 1, "maxLength": 300},
              "method": {"type": "string", "minLength": 1, "maxLength": 300},
              "status": {"enum": ["passed", "failed", "error", "skipped", "missing", "duplicate"]},
              "occurrences": {"type": "integer", "minimum": 0},
              "points": {"type": "number", "minimum": 0, "maximum": 1000000},
              "max_points": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}
            }
          }
        }
      }
    }
  }
}
