[Unit]
Description=finmath-classroom registration service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=finmath-classroom
Group=finmath-classroom
EnvironmentFile=/etc/finmath-classroom/classroom.env
WorkingDirectory=/var/lib/finmath-classroom
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java -jar /opt/finmath-classroom/finmath-classroom.jar serve
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=45

StateDirectory=finmath-classroom
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
