# Copy to /etc/finmath-classroom/classroom.env, owned by root with mode 0600.
# This is a systemd EnvironmentFile: use KEY=value lines without "export".
# Import the lecture configuration before starting the service.
CLASSROOM_DATA=/var/lib/finmath-classroom
CLASSROOM_PUBLIC_URL=https://classroom.example.org
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081

# Student sign-in client credentials; callback: PUBLIC_URL/auth/github/callback.
CLASSROOM_GITHUB_CLIENT_ID=
CLASSROOM_GITHUB_CLIENT_SECRET=

# Separate provisioning credential; automatic token renewal is not implemented.
CLASSROOM_GITHUB_TOKEN=

# Optional dedicated read-only Actions credential. If unset, collection uses
# CLASSROOM_GITHUB_TOKEN, which then also needs Actions: read on student repos.
# CLASSROOM_FEEDBACK_TOKEN=
# Workflow filename shared by the selected assignments (default: classroom.yml).
# CLASSROOM_FEEDBACK_WORKFLOW=classroom.yml

# Leave Moodle unset to use ordinary assignment links with registration keys.
# CLASSROOM_MOODLE_ISSUER=
# CLASSROOM_MOODLE_CLIENT_ID=
# CLASSROOM_MOODLE_DEPLOYMENT_ID=
# CLASSROOM_MOODLE_AUTH_URL=
# CLASSROOM_MOODLE_JWKS_URL=
